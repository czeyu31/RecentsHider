<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background">

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_back"
            android:padding="6dp"
            android:background="@drawable/bg_icon_circle"
            app:tint="@color/on_surface" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/adb_commands"
            android:textSize="18sp"
            android:textColor="@color/on_surface"
            android:fontFamily="sans-serif-medium"
            android:layout_marginStart="12dp" />

        <ImageView
            android:id="@+id/btnClear"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_close"
            android:padding="6dp"
            android:background="@drawable/bg_icon_circle"
            app:tint="@color/on_surface_variant" />
    </LinearLayout>

    <!-- Device Info -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_glass_card"
        android:padding="14dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/tvDeviceModel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="设备信息"
            android:textSize="16sp"
            android:textColor="@color/on_surface"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDeviceInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="12sp"
            android:textColor="@color/on_surface_variant"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- Quick Commands -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:layout_marginBottom="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnListPackages"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="包列表"
            android:textSize="11sp"
            android:textColor="@color/on_surface"
            android:backgroundTint="@color/surface_container_high"
            android:layout_marginEnd="4dp"
            style="@style/Widget.Material3.Button.TonalButton" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDeviceInfo"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="设备"
            android:textSize="11sp"
            android:textColor="@color/on_surface"
            android:backgroundTint="@color/surface_container_high"
            android:layout_marginHorizontal="4dp"
            style="@style/Widget.Material3.Button.TonalButton" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBattery"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:text="电池"
            android:textSize="11sp"
            android:textColor="@color/on_surface"
            android:backgroundTint="@color/surface_container_high"
            android:layout_marginStart="4dp"
            style="@style/Widget.Material3.Button.TonalButton" />
    </LinearLayout>

    <!-- Command Input -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:layout_marginBottom="8dp">

        <EditText
            android:id="@+id/etCommand"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:hint="输入命令..."
            android:textSize="14sp"
            android:textColor="@color/on_surface"
            android:textColorHint="@color/on_surface_variant"
            android:background="@drawable/bg_glass_card"
            android:paddingHorizontal="14dp"
            android:singleLine="true"
            android:fontFamily="monospace" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnExecute"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="执行"
            android:textSize="14sp"
            android:textColor="@color/on_primary"
            android:backgroundTint="@color/primary"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <!-- Output -->
    <ScrollView
        android:id="@+id/svOutput"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/bg_glass_card"
        android:layout_marginHorizontal="16dp"
        android:padding="14dp">

        <TextView
            android:id="@+id/tvOutput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="等待执行命令..."
            android:textSize="12sp"
            android:textColor="@color/on_surface_variant"
            android:fontFamily="monospace"
            android:lineSpacingExtra="4dp" />
    </ScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="16dp" />
</LinearLayout>
